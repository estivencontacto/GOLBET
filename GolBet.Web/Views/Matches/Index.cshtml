@model IReadOnlyList<GolBet.Services.DTOs.MatchDto>
@using GolBet.Entities.Enums
@{
    ViewData["Title"] = "Cartelera";
}

<header class="page-heading">
    <div>
        <h1>Cartelera de partidos</h1>
        <p>Horarios de Colombia, marcadores y cuotas en un solo recorrido.</p>
    </div>
</header>

<form class="search-form" method="get" asp-action="Index" role="search">
    <div>
        <label for="match-search">Buscar por equipo</label>
        <div class="search-controls">
            <input id="match-search" class="form-control" type="search" name="search" value="@ViewBag.CurrentSearch" placeholder="Ejemplo: nacional" />
            @if (ViewBag.CurrentStatus is not null)
            {
                <input type="hidden" name="status" value="@ViewBag.CurrentStatus" />
            }
            <button class="btn btn-primary" type="submit">Buscar</button>
        </div>
    </div>
</form>

<nav class="filter-bar" aria-label="Filtrar partidos por estado">
    <a class="filter-chip @(ViewBag.CurrentStatus is null ? "active" : "")" asp-action="Index" asp-route-search="@ViewBag.CurrentSearch">Todos</a>
    <a class="filter-chip @(ViewBag.CurrentStatus == MatchStatus.Scheduled ? "active" : "")" asp-action="Index" asp-route-status="Scheduled" asp-route-search="@ViewBag.CurrentSearch">Programados</a>
    <a class="filter-chip @(ViewBag.CurrentStatus == MatchStatus.Live ? "active" : "")" asp-action="Index" asp-route-status="Live" asp-route-search="@ViewBag.CurrentSearch">En vivo</a>
    <a class="filter-chip @(ViewBag.CurrentStatus == MatchStatus.Finished ? "active" : "")" asp-action="Index" asp-route-status="Finished" asp-route-search="@ViewBag.CurrentSearch">Finalizados</a>
</nav>

@if (Model.Count == 0)
{
    <section class="empty-state">
        <span aria-hidden="true">⚽</span>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.CurrentSearch))
        {
            <h2>No hay partidos para “@ViewBag.CurrentSearch”</h2>
            <p>Prueba otro nombre o vuelve a consultar toda la cartelera.</p>
        }
        else
        {
            <h2>No hay partidos con este estado</h2>
            <p>Selecciona otro filtro para continuar.</p>
        }
        <a class="btn btn-primary" asp-action="Index">Volver a la cartelera de partidos</a>
    </section>
}
else
{
<div class="match-grid">
    @foreach (var match in Model)
    {
        <article class="match-card">
            <div class="match-meta">
                <span class="status-badge status-@match.Status.ToString().ToLowerInvariant()">
                    <span aria-hidden="true">●</span> @match.StatusName
                </span>
                <time datetime="@match.MatchDate.ToString("s")">@match.MatchDate.ToString("ddd d MMM · h:mm tt")</time>
            </div>
            <div class="teams-row">
                <div class="team-block">
                    @if (!string.IsNullOrWhiteSpace(match.HomeTeamLogoUrl))
                    {
                        <img class="team-logo" src="@match.HomeTeamLogoUrl" alt="Escudo de @match.HomeTeamName" />
                    }
                    else
                    {
                        <span class="team-placeholder" aria-hidden="true">FC</span>
                    }
                    <strong>@match.HomeTeamName</strong>
                    <span>Local</span>
                </div>
                <div class="score-block">
                    @if (match.Status is MatchStatus.Live or MatchStatus.Finished)
                    {
                        <span>@(match.HomeScore ?? 0) - @(match.AwayScore ?? 0)</span>
                    }
                    else
                    {
                        <span>vs.</span>
                    }
                </div>
                <div class="team-block">
                    @if (!string.IsNullOrWhiteSpace(match.AwayTeamLogoUrl))
                    {
                        <img class="team-logo" src="@match.AwayTeamLogoUrl" alt="Escudo de @match.AwayTeamName" />
                    }
                    else
                    {
                        <span class="team-placeholder" aria-hidden="true">FC</span>
                    }
                    <strong>@match.AwayTeamName</strong>
                    <span>Visitante</span>
                </div>
            </div>
            <div class="odds-row" aria-label="Cuotas del partido">
                <span><small>1</small><strong>@match.HomeOdds.ToString("0.00")</strong></span>
                <span><small>X</small><strong>@match.DrawOdds.ToString("0.00")</strong></span>
                <span><small>2</small><strong>@match.AwayOdds.ToString("0.00")</strong></span>
            </div>
            <div class="match-card-footer">
                <span>@match.Venue · Fecha @match.Matchday</span>
                <a asp-action="Detail" asp-route-id="@match.Id">Ver detalle <span aria-hidden="true">→</span></a>
            </div>
        </article>
    }
</div>
}
